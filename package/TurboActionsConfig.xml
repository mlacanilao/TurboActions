            <input id="GameSpeedTurbo2MultiplierInput" char_limit="12">
                <placeholder>config.integer.placeholder</placeholder>
            </input>

            <topic>config.preset_hotkey.title</topic>
            <text id="GameSpeedTurbo2HotkeyDescription">config.preset_hotkey.description</text>
            <hlayout id="GameSpeedTurbo2HotkeyLayout">
                <vlayout id="GameSpeedTurbo2ModifierLayout">
                    <text id="GameSpeedTurbo2ModifierLabel">config.hotkey_modifier.name</text>
                    <one_choice id="GameSpeedTurbo2ModifierDropdown" type="dropdown">
                        <choice>
                            <contentId>config.dropdown.placeholder</contentId>
                        </choice>
                    </one_choice>
                </vlayout>
                <vlayout id="GameSpeedTurbo2MainKeyLayout">
                    <text id="GameSpeedTurbo2MainKeyLabel">config.hotkey_main_key.name</text>
                    <one_choice id="GameSpeedTurbo2MainKeyDropdown" type="dropdown">
                        <choice>
                            <contentId>config.dropdown.placeholder</contentId>
                        </choice>
                    </one_choice>
                </vlayout>
            </hlayout>
        </vlayout>
    </hlayout>

    <hlayout id="GameSpeedTurbo3Layout">
        <vlayout id="GameSpeedTurbo3Group" border="true">
            <title>config.game_speed_turbo_3.title</title>
            <text id="GameSpeedTurbo3Description">config.preset.description</text>

            <topic>config.preset_multiplier.title</topic>
            <input id="GameSpeedTurbo3MultiplierInput" char_limit="12">
                <placeholder>config.integer.placeholder</placeholder>
            </input>

            <topic>config.preset_hotkey.title</topic>
            <text id="GameSpeedTurbo3HotkeyDescription">config.preset_hotkey.description</text>
            <hlayout id="GameSpeedTurbo3HotkeyLayout">
                <vlayout id="GameSpeedTurbo3ModifierLayout">
                    <text id="GameSpeedTurbo3ModifierLabel">config.hotkey_modifier.name</text>
                    <one_choice id="GameSpeedTurbo3ModifierDropdown" type="dropdown">
                        <choice>
                            <contentId>config.dropdown.placeholder</contentId>
                        </choice>
                    </one_choice>
                </vlayout>
                <vlayout id="GameSpeedTurbo3MainKeyLayout">
                    <text id="GameSpeedTurbo3MainKeyLabel">config.hotkey_main_key.name</text>
                    <one_choice id="GameSpeedTurbo3MainKeyDropdown" type="dropdown">
                        <choice>
                            <contentId>config.dropdown.placeholder</contentId>
                        </choice>
                    </one_choice>
                </vlayout>
            </hlayout>
        </vlayout>
    </hlayout>
</config>
